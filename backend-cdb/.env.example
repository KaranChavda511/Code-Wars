# Backend env template — copy to .env and fill values
# Atlas project: ecommerce-backend (Cluster0) → DB "codewars"

PORT=2001
NODE_ENV=development

MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=2h

BCRYPT_ROUNDS=12

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Gemini key lives ONLY on the backend; never expose it to the browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
